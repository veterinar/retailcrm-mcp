{
  "mcpServers": {
    "retailcrm": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--init",
        "-e",
        "RETAILCRM_DOMAIN",
        "-e",
        "RETAILCRM_API_KEY",
        "-e",
        "RETAILCRM_READONLY",
        "-e",
        "RETAILCRM_RATE_LIMIT",
        "retailcrm-mcp:3.1.0"
      ]
    }
  }
}
