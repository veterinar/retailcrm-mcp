{
  "name": "retailcrm-mcp",
  "version": "3.1.0",
  "description": "MCP server for RetailCRM — 39 tools for orders, customers, inventory, payments, tasks & e-commerce analytics, transported via the official retailcrm/api-client-php 6.15.32 through a PHP bridge",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "retailcrm-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bin/retailcrm-api.php",
    "composer.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "contributors": [
    {
      "name": "Yahia",
      "url": "https://github.com/theYahia"
    }
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "russian-api",
    "retailcrm",
    "crm",
    "orders",
    "customers",
    "products",
    "ecommerce",
    "analytics",
    "delivery",
    "streamable-http",
    "api",
    "typescript",
    "e-commerce"
  ],
  "license": "MIT",
  "author": "Yahia"
}
